# Copy to .env and fill in. Never commit .env.
# Case writer (watsonx.ai / Granite). Leave blank to run on the template only.
WATSONX_APIKEY=
WATSONX_PROJECT_ID=
# A deployment space instead of the project (wins when both are set); see services/casewriter/README.md.
# WATSONX_SPACE_ID=
WATSONX_URL=https://us-south.ml.cloud.ibm.com
# Confirm the model ID against the watsonx project at hour 0 (names change; granite-3-8b-instruct is gone).
GRANITE_MODEL_ID=ibm/granite-4-h-small
# Replayer speed-up factor (data seconds per real second).
SPEED=600
# Redis host. Inside docker compose this is "redis" (the default); on a laptop use localhost.
# REDIS_HOST=localhost
# Reviewer bot (services/notifier/). Setup steps in services/notifier/README.md.
# Which chat adapter: console (prints cards, no network), slack.
NOTIFIER_ADAPTER=console
# Slack, Socket Mode (no inbound port): bot token xoxb-..., app-level token xapp-..., channel ID C...
# SLACK_BOT_TOKEN=
# SLACK_APP_TOKEN=
# SLACK_CHANNEL=
# Microsoft Teams Workflows webhook: optional, notification-only (no buttons), not yet implemented.
# TEAMS_WEBHOOK_URL=
# Link on every card to the investigator page (through the SSH tunnel).
DASHBOARD_URL=http://localhost:8501
# Hours a dismissed ring stays quiet unless it grows materially.
SUPPRESS_HOURS=24
