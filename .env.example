# Copy to .env and fill in. Never commit .env.
# Case writer (watsonx.ai / Granite). Leave blank to run on the template only.
WATSONX_APIKEY=
WATSONX_PROJECT_ID=
WATSONX_URL=https://us-south.ml.cloud.ibm.com
# Confirm the model ID against the watsonx project at hour 0 (names change).
GRANITE_MODEL_ID=ibm/granite-3-8b-instruct
# Replayer speed-up factor (data seconds per real second).
SPEED=600
# Redis host. Inside docker compose this is "redis" (the default); on a laptop use localhost.
# REDIS_HOST=localhost
