# Copy to .env and fill in. Never commit .env.
# Case writer (watsonx.ai / Granite). Leave blank to run on the template only.
WATSONX_APIKEY=
WATSONX_PROJECT_ID=
WATSONX_URL=https://us-south.ml.cloud.ibm.com
# Confirm the model ID against the watsonx project at hour 0 (names change).
GRANITE_MODEL_ID=ibm/granite-3-8b-instruct
# Replayer speed-up factor (data seconds per real second).
SPEED=600
# Redis host. Inside docker compose this is "redis" (the default); on a laptop use localhost.
# REDIS_HOST=localhost

# Reviewer bot (services/notifier): console prints each case as a card to the log.
NOTIFIER_ADAPTER=console
# Link on every card; the page is reached through the SSH tunnel.
DASHBOARD_URL=http://localhost:8501
# A dismissed ring is not re-posted for this many hours unless it grows materially.
SUPPRESS_HOURS=24
# NOTIFIER_NAME=notifier
